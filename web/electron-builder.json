{
  "appId": "com.vmware.octant",
  "productName": "Octant",
  "directories": {
    "output": "release/"
  },
  "extraResources": [
    "extraResources/octant"
  ],
  "files": [
    "**/*",
    "!**/*.ts",
    "!*.code-workspace",
    "!LICENSE.md",
    "!package.json",
    "!package-lock.json",
    "!src/",
    "!e2e/",
    "!hooks/",
    "!angular.json",
    "!_config.yml",
    "!karma.conf.js",
    "!tsconfig.json",
    "!tslint.json"
  ],
  "nsis": {
    "differentialPackage": false
  },
  "dmg": {
    "writeUpdateInfo": false
  },
  "win": {
    "icon": "dist/octant/assets/icons/icon.ico",
    "target": ["nsis"]
  },
  "mac": {
    "icon": "dist/octant/assets/icons/icon.icns",
    "target": ["dmg"]
  },
  "linux": {
    "icon": "dist/octant/assets/icons/icon.png",
    "category": "development",
    "target": ["AppImage"]
  },
  "nodeGypRebuild": false,
  "npmRebuild": false,
  "buildDependenciesFromSource": false,
  "electronDist": "/usr/local/bin"
}
